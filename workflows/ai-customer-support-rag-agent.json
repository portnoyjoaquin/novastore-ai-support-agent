    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Pinecone puede devolver matches directamente\n// o dentro de results, según la respuesta.\nconst matches = data.matches || data.results?.matches || [];\n\nif (matches.length === 0) {\n  return [{\n    json: {\n      rag_context: 'No relevant information was found in the knowledge base.',\n      retrieved_chunks: 0\n    }\n  }];\n}\n\nconst context = matches\n  .filter(match => match.metadata?.text)\n  .map((match, index) => {\n    return `[Source ${index + 1} | Score: ${match.score?.toFixed(3) ?? 'N/A'}]\n${match.metadata.text}`;\n  })\n  .join('\\n\\n---\\n\\n');\n\nreturn [{\n  json: {\n    rag_context: context,\n    retrieved_chunks: matches.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
