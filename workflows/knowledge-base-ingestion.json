      "id": "ff13de9b-9227-4299-8dff-77a87994a90d",
      "name": "Extract PDF Text"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst text = items[0].json.text;\n\nif (!text) {\n  throw new Error('No se encontró el campo \"text\" del PDF.');\n}\n\n// Configuración del chunking\nconst chunkSize = 1000;\nconst overlap = 200;\n\nconst chunks = [];\n\nlet start = 0;\nlet chunkId = 1;\n\nwhile (start < text.length) {\n  let end = Math.min(start + chunkSize, text.length);\n\n  // Intentar terminar el chunk en un corte natural\n  if (end < text.length) {\n    const section = text.slice(start, end);\n\n    const lastParagraph = section.lastIndexOf('\\n\\n');\n    const lastSentence = section.lastIndexOf('. ');\n\n    if (lastParagraph > chunkSize * 0.6) {\n      end = start + lastParagraph + 2;\n    } else if (lastSentence > chunkSize * 0.6) {\n      end = start + lastSentence + 1;\n    }\n  }\n\n  const chunkText = text\n    .slice(start, end)\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  if (chunkText.length > 0) {\n    chunks.push({\n      json: {\n        text: chunkText,\n        chunk_id: chunkId,\n        source: 'NovaStore_Customer_Support_Knowledge_Base.pdf',\n        document: 'NovaStore Customer Support Knowledge Base',\n        version: '1.0'\n      }\n    });\n\n    chunkId++;\n  }\n\n  if (end >= text.length) break;\n\n  start = Math.max(end - overlap, start + 1);\n}\n\nreturn chunks;;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "53c51496-2ff1-4883-95c0-6769ea0f6ef4",
      "name": "Chunk Document"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-2:embedContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": {\n    \"parts\": [\n      {\n        \"text\": \"={{ $json.text }}\"\n      }\n    ]\n  },\n  \"output_dimensionality\": 768\n}",
        "options": {}
      },
